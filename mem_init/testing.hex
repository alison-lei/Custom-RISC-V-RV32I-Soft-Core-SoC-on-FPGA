//80000093  // addi x1, x0, -2048     x1 = 0xFFFFF800 -> sh writes 0xF800 (red)
//00001237  // lui  x4, 0x1
//20020213  // addi x4, x4, 0x200     x4 = 0x1200  (cpu_done trigger)
//0002C2B7  // lui  x5, 0x2C
//80028293  // addi x5, x5, -2048     x5 = 0x2B800  (bufA end)
//000513B7  // lui  x7, 0x51
//00038393  // addi x7, x7, 0         x7 = 0x51000  (bufB end)
//00006137  // lui  x2, 0x6           x2 = 0x6000   (bufA start) [loopA target]
//00111023  // sh   x1, 0(x2)
//00210113  // addi x2, x2, 2
//FE514CE3  // blt  x2, x5, loopA     -8
//0002C337  // lui  x6, 0x2C
//80030313  // addi x6, x6, -2048     x6 = 0x2B800  (bufB start)
//00131023  // sh   x1, 0(x6)         [loopB target]
//00230313  // addi x6, x6, 2
//FE734CE3  // blt  x6, x7, loopB     -8
//00022023  // sw   x0, 0(x4)         signal cpu_done (once)
//0000006F  // jal  x0, 0             halt

123450B7   //; x1 = 0x12345000
67808093   //; x1 = 0x12345678  (sentinel)
00005137   //; x2 = 0x5000
00112023   //; mem[0x5000] = sentinel
00012183   //; x3 = mem[0x5000]
00100213   //; assume match: x4 = 1
00308463   //; if x1==x3, skip the clear (to 0x20)
00000213   //; mismatch: x4 = 0
00005537   //; x5 = 0x5000
10028293   //; x5 = 0x5100  (result flag addr)
0042A023   //; mem[0x5100] = x4  → latches LEDG6
00000013
0000006F   //; halt