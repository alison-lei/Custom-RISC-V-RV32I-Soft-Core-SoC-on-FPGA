0F800093 // addi x1, x0, 0xF8      x1 = 0x000000F8  (byte-swapped red, testing endianness theory)
00006137 // lui  x2, 0x6           x2 = 0x00006000  (framebuffer start, swap_bit=0)
0002C1B7 // lui  x3, 0x2C          x3 = 0x0002C000
80018193 // addi x3, x3, -2048     x3 = 0x0002B800  (framebuffer end, exclusive: 6000 + 76800*2)
00111023 // sh   x1, 0(x2)         loop: write one red pixel (halfword)
00210113 // addi x2, x2, 2         advance by one pixel (16-bit stride)
FE314CE3 // blt  x2, x3, loop      (offset -8, still 2 instructions back to the sh)
00001237 // lui  x4, 0x1
20020213 // addi x4, x4, 0x200     x4 = 0x00001200
00022023 // sw   x0, 0(x4)         signal cpu_done -> triggers frame swap/send
0000006F // halt: jal x0, 0        (infinite self-loop)